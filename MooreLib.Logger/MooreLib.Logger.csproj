<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFrameworks>net8.0;net462</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
	<GenerateDependencyFile>false</GenerateDependencyFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/bobapplemac/MooreLib.Logger</PackageProjectUrl>
    <Description>Structured, context-aware .NET logging built on NLog, with logical entries, progressive inline output, nested formatting, and structured properties.</Description>
    <Copyright>Copyright 2026 Andrew J. Moore</Copyright>
    <RepositoryUrl>https://github.com/bobapplemac/MooreLib.Logger</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <FileVersion>1.22.0.0</FileVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <Title>MooreLib.Logger</Title>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <Nullable>disable</Nullable>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net462" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

	<Target Name="CopyLicenseFilesToOutput" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\..\LICENSE"
      DestinationFiles="$(TargetDir)LICENSE-MooreLib.Logger.txt"
      SkipUnchangedFiles="true" />

    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\..\THIRD-PARTY-NOTICES\LICENSE-NLog.txt"
      DestinationFiles="$(TargetDir)LICENSE-NLog.txt"
      SkipUnchangedFiles="true" />
  </Target>

	<Target Name="CleanLicenseFilesFromOutput" BeforeTargets="CoreClean" Condition="'$(TargetFramework)' != ''">
    <Delete Files="$(TargetDir)LICENSE-MooreLib.Logger.txt" />
    <Delete Files="$(TargetDir)LICENSE-NLog.txt" />
  </Target>

</Project>
